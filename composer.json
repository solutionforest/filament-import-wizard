{
    "name": "solution-forest/filament-import-wizard",
    "description": "Import and export CSV and Excel in Filament v5: a four-step upload, map, review, import wizard with live preview, row-by-row validation before import, huge-file support, round-trip export, audit/approval and a headless API.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "filament",
        "filament-plugin",
        "filamentphp",
        "laravel",
        "livewire",
        "import",
        "export",
        "csv",
        "excel",
        "xlsx",
        "spreadsheet",
        "importer",
        "exporter",
        "wizard",
        "validation",
        "bulk-import",
        "data-import"
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "laravel/pint": "^1.0",
        "orchestra/workbench": "^9.0|^10.0|^11.0",
        "larastan/larastan": "^3.15",
        "phpoffice/phpspreadsheet": "^5.11"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentImportWizard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\FilamentImportWizard\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentImportWizard\\ImportWizardServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "serve": [
            "@php vendor/bin/testbench workbench:build --no-interaction",
            "@php vendor/bin/testbench filament:assets",
            "@php vendor/bin/testbench serve --host=127.0.0.1 --port=8765"
        ],
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@security"
        ],
        "stress": "pest --group=stress -d memory_limit=256M",
        "fuzz": [
            "@putenv IMPORT_WIZARD_FUZZ_CASES=300000",
            "pest tests/Fuzz tests/FastRulesTest.php"
        ],
        "mutate": "@php workbench/tools/mutation-test.php",
        "lint": "pint --test",
        "security": [
            "pest --group=security",
            "@composer audit"
        ]
    },
    "suggest": {
        "phpoffice/phpspreadsheet": "Required to import legacy .xls files (loaded fully into memory, so keep those files modest).",
        "maatwebsite/excel": "Files written by Laravel Excel import fine (it needs no integration); use a StringValueBinder for codes and phone numbers.",
        "spatie/simple-excel": "Files written by Simple Excel import fine.",
        "rap2hpoutre/fast-excel": "Files written by Fast Excel import fine."
    },
    "support": {
        "issues": "https://github.com/solutionforest/filament-import-wizard/issues",
        "source": "https://github.com/solutionforest/filament-import-wizard",
        "docs": "https://github.com/solutionforest/filament-import-wizard/tree/main/docs"
    },
    "homepage": "https://github.com/solutionforest/filament-import-wizard",
    "authors": [
        {
            "name": "Solution Forest",
            "homepage": "https://github.com/solutionforest"
        }
    ]
}