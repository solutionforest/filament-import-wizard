{
    "name": "solution-forest/filament-import-wizard",
    "description": "Self-hosted Filament v5 import wizard: Upload \u2192 Map \u2192 Review \u2192 Import. CSV, XLSX, ODS and XLS, huge files, pre-import validation, reusable rules, smart column mapping, multi-panel.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "filament",
        "laravel",
        "import",
        "csv",
        "excel",
        "wizard"
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "laravel/pint": "^1.0",
        "orchestra/workbench": "^9.0|^10.0|^11.0",
        "larastan/larastan": "^3.15",
        "phpoffice/phpspreadsheet": "^5.11"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentImportWizard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\FilamentImportWizard\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentImportWizard\\ImportWizardServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "serve": [
            "@php vendor/bin/testbench workbench:build --no-interaction",
            "@php vendor/bin/testbench filament:assets",
            "@php vendor/bin/testbench serve --host=127.0.0.1 --port=8765"
        ],
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "suggest": {
        "phpoffice/phpspreadsheet": "Required to import legacy .xls files (loaded fully into memory, so keep those files modest)."
    },
    "support": {
        "source": "https://github.com/solutionforest/filament-import-wizard"
    }
}